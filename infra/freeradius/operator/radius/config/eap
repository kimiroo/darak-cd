eap {
    default_eap_type = ttls
    timer_expire = 60
    ignore_unknown_eap_types = no
    max_sessions = 4096

    tls-config tls-common {
        private_key_file = /etc/freeradius/certs/tls.key
        # cert-manager's tls.crt is leaf + intermediates, which is what supplicants need
        certificate_file = /etc/freeradius/certs/tls.crt
        tls_min_version = "1.2"
        tls_max_version = "1.2"
    }

    ttls {
        tls = tls-common
        default_eap_type = md5
        copy_request_to_tunnel = no
        # The proxied reply of authentik carries the user uuid (Class) and the VLAN
        # (Tunnel-*). The registry check in the default server's post-auth and the AP's
        # VLAN assignment need them in the outer reply, which this copies them to.
        use_tunneled_reply = yes
        virtual_server = "inner-tunnel"
    }
}
