eap {
    default_eap_type = tls
    timer_expire = 60
    ignore_unknown_eap_types = no
    max_sessions = 4096

    tls-config tls-common {
        # What the devices verify: the public (GTS) certificate for radius.darak.dev.
        private_key_file = /etc/freeradius/certs/tls.key
        # cert-manager's tls.crt is leaf + intermediates, which is what supplicants need
        certificate_file = /etc/freeradius/certs/tls.crt

        # Trust anchors for CLIENT certificates: the dedicated Wi-Fi root and its intermediate, nothing else.
        # Device certificates are signed by the intermediate, so the intermediate must be in this file
        # (a root-only file fails with "unable to get local issuer certificate").
        # Anything not issued by them (including the mTLS CAs of this cluster) fails the handshake.
        ca_file = /etc/freeradius/wifi-ca/ca.crt

        tls_min_version = "1.2"
        tls_max_version = "1.2"

        # The certificate CN must equal the EAP identity the device announced.
        check_cert_cn = %{User-Name}
    }

    tls {
        tls = tls-common
        # Runs once, just before the final Accept: registry, LDAP and VLAN.
        virtual_server = check-eap-tls
    }
}
