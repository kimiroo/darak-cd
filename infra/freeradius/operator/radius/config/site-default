server default {
    listen {
        type = auth
        ipaddr = *
        port = 1812
    }

    listen {
        type = auth
        ipv6addr = ::
        port = 1812
    }

    authorize {
        filter_username
        preprocess
        eap {
            ok = return
        }
    }

    authenticate {
        eap
    }

    # The inner tunnel is proxied to authentik. When its reply comes back the eap
    # module must finish the EAP-TTLS exchange: it builds the EAP-Success and the
    # MS-MPPE keys the AP needs for the 4-way handshake. Without this the Accept
    # carries only authentik's attributes and the client never gets connected.
    post-proxy {
        eap
    }

    post-auth {
        # Device registry. This runs once authentik has accepted the user. The proxied
        # reply carries the user uuid in Class, and the AP's own Calling-Station-Id is
        # the device MAC (it comes from the outer request, never from the inner tunnel
        # where the supplicant could write anything). Any missing or malformed value,
        # or any database error, ends in a reject.
        update request {
            &Tmp-String-0 := "%{string:&reply:Class}"
            &Tmp-String-1 := "%{Calling-Station-Id}"
        }

        if (&Tmp-String-0 !~ /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i) {
            reject
        }
        if (&Tmp-String-1 !~ /^([0-9a-f]{2}[-:.]?){5}[0-9a-f]{2}$/i) {
            reject
        }
        if ("%{sql:SELECT wifi_check('%{Tmp-String-0}'::uuid, '%{Tmp-String-1}'::macaddr)}" != "t") {
            reject
        }

        # The uuid was only needed for the check above, the AP has no use for it.
        # The VLAN attributes authentik returned stay in the reply as they are.
        update reply {
            &Class !* ANY
        }

        Post-Auth-Type REJECT {
            attr_filter.access_reject
            eap
            remove_reply_message_if_eap
        }
    }
}
