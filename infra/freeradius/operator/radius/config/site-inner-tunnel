# The inner PAP request is forwarded to the authentik RADIUS outpost, which owns
# users, passwords and MFA. FreeRADIUS holds no credentials.
#
# A proxied inner request never reaches this server's post-auth: the reply of the
# home server (Class, Tunnel-*) goes straight into the outer reply. The device
# registry check therefore lives in the post-auth of the default server.
server inner-tunnel {
    authorize {
        filter_username
        update control {
            Proxy-To-Realm := "authentik"
        }
    }

    authenticate {
    }
}
